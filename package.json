{
    "repository": {
        "type": "git",
        "url": "https://github.com/Query-farm-haybarn/haybarn-wasm.git"
    },
    "private": true,
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "lint:fix": "yarn workspace @haybarn/haybarn-wasm lint --fix && yarn workspace @haybarn/benchmarks lint --fix && yarn workspace @haybarn/haybarn-wasm-shell lint --fix",
        "docs": "yarn workspace @haybarn/haybarn-wasm docs",
        "benchmarks:build:browser": "yarn workspace @haybarn/benchmarks build:browser",
        "benchmarks:build:node": "yarn workspace @haybarn/benchmarks build:node",
        "benchmarks:build": "yarn workspace @haybarn/benchmarks build"
    },
    "devDependencies": {
        "badge-maker": "^3.3.1"
    }
}
