Haybarn wasm threads: force single-threaded extension LOAD.

The threaded (COI) build reads an extension's binary via a synchronous XHR;
with background scheduler threads running, that blocking fetch deadlocks
across the worker/main-thread boundary and LOAD hangs. Quiesce the
scheduler to one thread for the duration of InitialLoad, then restore.
Gated on __EMSCRIPTEN__; no-op on single-threaded wasm builds.

diff --git a/src/main/extension/extension_load.cpp b/src/main/extension/extension_load.cpp
--- a/src/main/extension/extension_load.cpp
+++ b/src/main/extension/extension_load.cpp
@@ -10,6 +10,7 @@
 #include "duckdb/main/extension_manager.hpp"
 #include "duckdb/main/settings.hpp"
 #include "duckdb/main/extension.hpp"
+#include "duckdb/parallel/task_scheduler.hpp"
 #include "mbedtls_wrapper.hpp"
 
 
@@ -710,6 +711,34 @@
 ExtensionInitResult ExtensionHelper::InitialLoad(DatabaseInstance &db, FileSystem &fs, const string &extension) {
 	string error;
 	ExtensionInitResult result;
+#ifdef __EMSCRIPTEN__
+	// Haybarn wasm: an extension is fetched/read via a *synchronous* XHR. In the
+	// threaded (COI / -pthread) build, performing that blocking fetch while the
+	// scheduler has background worker threads deadlocks — the fetch is dispatched
+	// across the worker/main-thread boundary while the other side is blocked
+	// (ALLOW_BLOCKING_ON_MAIN_THREAD=1), so LOAD hangs forever with the XHR stuck
+	// pending. Quiesce the scheduler to a single thread for the duration of the
+	// load, then restore the previous count. RAII so the restore runs even if the
+	// load throws. external_threads is 1 in the wasm build; on a single-threaded
+	// wasm build NumberOfThreads()==1 so this whole block is a no-op.
+	auto &load_scheduler = TaskScheduler::GetScheduler(db);
+	const int32_t load_prev_threads = load_scheduler.NumberOfThreads();
+	struct WasmSingleThreadDuringLoad {
+		TaskScheduler &scheduler;
+		int32_t restore_threads;
+		bool active;
+		~WasmSingleThreadDuringLoad() {
+			if (active) {
+				scheduler.SetThreads(static_cast<idx_t>(restore_threads), 1);
+				scheduler.RelaunchThreads();
+			}
+		}
+	} load_thread_guard {load_scheduler, load_prev_threads, load_prev_threads > 1};
+	if (load_prev_threads > 1) {
+		load_scheduler.SetThreads(1, 1);
+		load_scheduler.RelaunchThreads();
+	}
+#endif
 	if (!TryInitialLoad(db, fs, extension, result, error)) {
 		if (!Settings::Get<AutoinstallKnownExtensionsSetting>(db) || !ExtensionHelper::AllowAutoInstall(extension)) {
 			throw IOException(error);
