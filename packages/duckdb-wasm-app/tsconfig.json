{
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "./build/ts/",
        "target": "es5",
        "module": "es2020",
        // TODO(ankoh): Upgrade node resolution to node12 for exports once typescript 4.6.0 is out
        // https://www.typescriptlang.org/docs/handbook/esm-node.html
        "moduleResolution": "node",
        // node10 resolution ignores `exports`, so the `/vgi` subpath export has
        // to be mapped by hand (mirrors the webpack alias in webpack.common.js).
        "paths": {
            "@haybarn/haybarn-wasm/vgi": ["../../duckdb-wasm/dist/duckdb-browser-vgi"]
        },
        "sourceMap": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "downlevelIteration": true,
        "strict": true,
        "jsx": "react",
        "types": ["emscripten", "node", "jasmine"],
        "plugins": [{ "name": "typescript-plugin-css-modules" }],
        "lib": ["es6", "es2020", "dom"]
    },
    "exclude": ["./node_modules"],
    "include": ["./src/**/*", "./test/**/*", "./types/*.d.ts"]
}
